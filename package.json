{
  "name": "compagelato",
  "productName": "CompaGelato",
  "version": "1.0.0",
  "description": "ERP de gestion — documents comptables, clients, stock consommables et optimisation de tournées de livraison.",
  "author": {
    "name": "CompaGelato"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "server": "npm run build && node dist/server/server.mjs",
    "test": "node scripts/build-tests.mjs && node --test tests/utils.test.mjs tests/parse.test.mjs tests/bank.test.mjs tests/sort.test.mjs tests/search.test.mjs tests/registers.test.mjs tests/packaging.test.mjs tests/optimize.test.mjs tests/mail.test.mjs tests/updater.test.mjs tests/restore.test.mjs tests/autobackup.test.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "node scripts/postinstall.mjs",
    "test:e2e": "npm run build && node --test tests/e2e.test.mjs tests/server.test.mjs tests/remote.test.mjs tests/permissions.test.mjs tests/offline.test.mjs tests/mobile.test.mjs tests/updates.remote.test.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "screenshots": "npm run build && node tests/screenshots.mjs",
    "icon": "python3 build/make-icon.py"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^5.2.5",
    "pdfjs-dist": "4.10.38",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright": "^1.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "fr.compagelato.erp",
    "productName": "CompaGelato",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CompaGelato-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CompaGelato",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
